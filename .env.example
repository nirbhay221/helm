# Copy to .env and fill. DEMO_MODE=1 runs the deterministic core with no keys.
DEMO_MODE=1

# PayPal sandbox REST app (Testing Tools -> Sandbox Accounts, then an app)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PUBLIC_URL=

# Model for the agent brain: any OpenAI-compatible chat endpoint. The code names
# no vendor; set the base URL, model id and key here. With no key the agent uses
# its scripted fallback so the system still runs end to end.
HELM_LLM_BASE_URL=https://openrouter.ai/api/v1
HELM_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
HELM_LLM_API_KEY=
HELM_LLM_TIMEOUT=60

# Alpaca paper trading (optional): routes real paper orders for investing and pooling.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Channel3 product search (optional, free key at channel3.ai): powers the buyer-side
# "Spend earnings" product search. With no key it uses a built-in demo catalog.
CHANNEL3_API_KEY=

# Marketplace settlement (optional)
# JSON map of marketplace seller id -> PayPal sandbox seller (business) account email.
# A mapped creator is named as the order's payee; anyone unmapped settles to the platform account.
HELM_SELLER_PAYEE_EMAILS=
# 1 only for an approved PayPal partner: adds platform_fees and DELAYED disbursement to orders.
HELM_PAYPAL_MULTIPARTY=0
# Sandbox only: use PayPal's published test card as the buyer's approval for server-side holds.
HELM_SANDBOX_BUYER_CARD=1
