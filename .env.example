# Copy to .env and fill. DEMO_MODE=1 runs the deterministic core with no keys.
DEMO_MODE=1

# PayPal sandbox REST app (Testing Tools -> Sandbox Accounts, then an app)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PUBLIC_URL=

# Model: via Amazon Bedrock (preferred) or a direct key. Model id stays in config, not code.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
ANTHROPIC_API_KEY=
